{
  "name": "aura-audio",
  "productName": "Aura Audio",
  "private": true,
  "version": "1.0.0",
  "description": "High-end studio grade local audio and podcast player for Windows",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "node scripts/launch-electron.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && node scripts/launch-electron.cjs\""
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "music-metadata": "^12.0.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
